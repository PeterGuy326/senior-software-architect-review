# Cloud API only. Copy to .env locally; never put secrets in miniprogram/config.local.js.
APP_ENV=development
TCB_ENV_ID=
TCB_SERVICE_NAME=wuji-coach-dev
DATABASE_URL=
STORAGE_TRANSPORT=cloudbase_rpc
CLOUDBASE_SERVER_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CONTENT_RELEASE_ID=
# cloud uses wx.cloud.callContainer after associating the Mini Program; no own domain.
MINI_TRANSPORT=cloud
# Only required for MINI_TRANSPORT=https; register its request domain in WeChat.
API_BASE_URL=
# CI private key stays outside the repository; point to its local path.
MINIPROGRAM_PRIVATE_KEY_PATH=
# Server-side Agent provider. Never put the key in the Mini Program.
# Free candidate: MODEL_PROVIDER=bigmodel, MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4,
# MODEL_NAME=glm-4.7-flash. Its separate key is entered in .study/platform/glm-input.env.
MODEL_PROVIDER=siliconflow
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen3-8B
MODEL_FREE_ONLY=true
MODEL_API_KEY=
KNOWLEDGE_RELEASE_ID=
